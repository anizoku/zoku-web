{
  "name": "FanArt",
  "type": "object",
  "properties": {
    "image_url": {
      "type": "string",
      "description": "URL da arte de f\u00e3 (upload)"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo da arte (opcional)"
    },
    "work_slug": {
      "type": "string",
      "description": "Slug da obra vinculada no cat\u00e1logo (opcional \u2014 se setado, a arte linka para /obra/:slug)"
    },
    "work_title": {
      "type": "string",
      "description": "T\u00edtulo da obra para exibi\u00e7\u00e3o no admin"
    },
    "artist_name": {
      "type": "string",
      "description": "Nome do artista"
    },
    "artist_instagram": {
      "type": "string",
      "description": "Handle ou URL do Instagram do artista"
    },
    "artist_twitter": {
      "type": "string",
      "description": "Handle ou URL do Twitter/X do artista"
    },
    "artist_website": {
      "type": "string",
      "description": "URL do site/portf\u00f3lio do artista"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se a arte \u00e9 exibida na faixa da home"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o (menor = primeiro)"
    }
  },
  "required": [
    "image_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}