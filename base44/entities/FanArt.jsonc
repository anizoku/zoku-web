{
  "name": "FanArt",
  "type": "object",
  "properties": {
    "image_url": {
      "type": "string",
      "description": "URL da arte de f\u00e3 (upload)"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo da arte (opcional)"
    },
    "work_slug": {
      "type": "string",
      "description": "Slug da obra vinculada no cat\u00e1logo (opcional \u2014 se setado, a arte linka para /obra/:slug). Preenchido automaticamente pelo WorkPicker do admin."
    },
    "work_title": {
      "type": "string",
      "description": "T\u00edtulo da obra para exibi\u00e7\u00e3o. Preenchido automaticamente junto com work_slug pelo WorkPicker \u2014 n\u00e3o editar independentemente quando obra vinculada."
    },
    "artist_name": {
      "type": "string",
      "description": "Nome do artista (obrigat\u00f3rio para novas artes)"
    },
    "artist_instagram": {
      "type": "string",
      "description": "Handle ou URL do Instagram do artista"
    },
    "artist_twitter": {
      "type": "string",
      "description": "Handle ou URL do Twitter/X do artista"
    },
    "artist_website": {
      "type": "string",
      "description": "URL do site/portf\u00f3lio do artista"
    },
    "source_url": {
      "type": "string",
      "description": "URL da publica\u00e7\u00e3o/origem original da arte (opcional)"
    },
    "credit_notes": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o interna sobre cr\u00e9dito/permiss\u00e3o (somente admin, n\u00e3o aparece na Home)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se a arte \u00e9 exibida na faixa da home"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de organiza\u00e7\u00e3o no Admin (menor = primeiro). A Home embaralha as artes, ent\u00e3o este campo n\u00e3o define ordem p\u00fablica."
    }
  },
  "required": [
    "image_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.active": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}