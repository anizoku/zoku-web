{
  "name": "Community",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "members_count": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "anime",
        "manga",
        "general",
        "theories",
        "reviews",
        "news"
      ],
      "default": "general"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "creator_email": {
      "type": "string",
      "description": "Email of the community creator"
    }
  },
  "required": [
    "name"
  ]
}