{
  "name": "UserAchievement",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que desbloqueou"
    },
    "achievement_key": {
      "type": "string",
      "description": "key da conquista desbloqueada"
    },
    "unlocked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora exata do desbloqueio"
    }
  },
  "required": [
    "user_email",
    "achievement_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}