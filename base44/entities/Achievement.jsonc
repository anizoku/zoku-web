{
  "name": "Achievement",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Identificador est\u00e1vel (ex: ep_1000)"
    },
    "name": {
      "type": "string",
      "description": "Nome de exibi\u00e7\u00e3o"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "Nome do \u00edcone lucide-react"
    },
    "category": {
      "type": "string"
    },
    "xp": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "key",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}