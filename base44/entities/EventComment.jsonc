{
  "name": "EventComment",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "content"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}",
      "data.author_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "created_by": "{{user.email}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "created_by": "{{user.email}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}