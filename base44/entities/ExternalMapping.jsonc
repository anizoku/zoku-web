{
  "name": "ExternalMapping",
  "type": "object",
  "properties": {
    "work_group_id": {
      "type": "string",
      "description": "DynamicWork.id (nullable quando mapeia s\u00f3 release)"
    },
    "work_release_id": {
      "type": "string",
      "description": "WorkRelease.id (nullable quando mapeia s\u00f3 grupo)"
    },
    "provider": {
      "type": "string",
      "enum": [
        "anilist",
        "mal",
        "tmdb",
        "thetvdb"
      ],
      "description": "Provider can\u00f4nico. Jikan N\u00c3O \u00e9 um provider \u2014 IDs do Jikan usam provider=mal (Jikan espelha MAL)."
    },
    "provider_id": {
      "type": "string",
      "description": "ID no provedor (string p/ suportar IDs grandes)"
    },
    "provider_url": {
      "type": "string",
      "description": "URL do recurso no provedor"
    },
    "provider_type": {
      "type": "string",
      "description": "Tipo do recurso no provedor (anime|manga|movie|tv|etc.)"
    },
    "confidence_score": {
      "type": "number",
      "default": 100,
      "description": "100 quando match por ID exato"
    },
    "verified_by_admin": {
      "type": "boolean",
      "default": false,
      "description": "true quando o admin confirmou o match manualmente"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima sincroniza\u00e7\u00e3o"
    }
  },
  "required": [
    "provider",
    "provider_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}