{
  "name": "LoginBackgroundImage",
  "type": "object",
  "properties": {
    "image_url": {
      "type": "string",
      "description": "URL da imagem de fundo exibida no login"
    },
    "title": {
      "type": "string",
      "description": "Identifica\u00e7\u00e3o interna (opcional)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Apenas imagens ativas entram na rota\u00e7\u00e3o do login"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o no carrossel (menor = primeiro)"
    }
  },
  "required": [
    "image_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}