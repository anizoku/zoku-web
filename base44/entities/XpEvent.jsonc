{
  "name": "XpEvent",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que recebeu o XP"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "achievement_unlocked",
        "level_up",
        "episode_watched",
        "chapter_read",
        "post_created",
        "work_completed",
        "anime_added",
        "legacy_migration"
      ],
      "description": "Tipo do evento. legacy_migration = baseline de migra\u00e7\u00e3o de XP legado (exclu\u00eddo do ranking semanal/mensal)."
    },
    "achievement_id": {
      "type": "string",
      "description": "ID da conquista (se event_type = achievement_unlocked)"
    },
    "xp_amount": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de XP concedida. Resolvido centralmente pelo backend grantXp \u2014 componentes n\u00e3o devem definir este valor."
    },
    "event_date": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp do evento (definido pelo backend, n\u00e3o pelo cliente)"
    },
    "source_type": {
      "type": "string",
      "description": "Tipo da fonte que gerou o evento (ex: anime_entry, post, achievement). Para auditoria."
    },
    "source_id": {
      "type": "string",
      "description": "ID da entidade fonte (ex: entry_id, post_id, achievement_id). Para auditoria."
    },
    "idempotency_key": {
      "type": "string",
      "description": "Chave de idempot\u00eancia \u00fanica por usu\u00e1rio+a\u00e7\u00e3o. Constru\u00edda pelo backend grantXp. Garante que a mesma a\u00e7\u00e3o n\u00e3o conceda XP duas vezes. Target Supabase: UNIQUE(user_id, idempotency_key)."
    }
  },
  "required": [
    "user_email",
    "event_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}