{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Linked user email (unique)"
    },
    "username": {
      "type": "string",
      "description": "@username handle"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "links": {
      "type": "object",
      "properties": {
        "twitter": {
          "type": "string"
        },
        "instagram": {
          "type": "string"
        },
        "website": {
          "type": "string"
        }
      }
    },
    "favorite_animes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "favorite_mangas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "list_visibility": {
      "type": "string",
      "enum": [
        "public",
        "friends",
        "private"
      ],
      "default": "public"
    },
    "profile_visibility": {
      "type": "string",
      "enum": [
        "public",
        "friends",
        "private"
      ],
      "default": "public"
    },
    "profile_setup_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed the first-login profile setup"
    },
    "profile_setup_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user completed profile setup"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}