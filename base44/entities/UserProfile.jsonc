{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Linked user email (unique)"
    },
    "username": {
      "type": "string",
      "description": "@username handle"
    },
    "display_name": {
      "type": "string",
      "description": "Optional display name"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "avatar_crop": {
      "type": "object",
      "description": "Crop/position data for avatar image",
      "properties": {
        "scale": {
          "type": "number"
        },
        "offsetX": {
          "type": "number"
        },
        "offsetY": {
          "type": "number"
        }
      }
    },
    "banner_url": {
      "type": "string"
    },
    "banner_crop": {
      "type": "object",
      "description": "Crop/position data for banner image",
      "properties": {
        "scale": {
          "type": "number"
        },
        "offsetX": {
          "type": "number"
        },
        "offsetY": {
          "type": "number"
        }
      }
    },
    "country": {
      "type": "string"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "pt",
        "en",
        "es",
        "ja",
        "other"
      ]
    },
    "links": {
      "type": "object",
      "properties": {
        "twitter": {
          "type": "string"
        },
        "instagram": {
          "type": "string"
        },
        "website": {
          "type": "string"
        }
      }
    },
    "favorite_animes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "favorite_mangas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "selected_badge_id": {
      "type": "string",
      "description": "ID of the achievement badge the user chose to display on their avatar"
    },
    "list_visibility": {
      "type": "string",
      "enum": [
        "public",
        "friends",
        "private"
      ],
      "default": "public"
    },
    "profile_visibility": {
      "type": "string",
      "enum": [
        "public",
        "friends",
        "private"
      ],
      "default": "public"
    },
    "profile_setup_completed": {
      "type": "boolean",
      "default": false
    },
    "profile_setup_completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}