{
  "name": "News",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo curto da not\u00edcia"
    },
    "summary": {
      "type": "string",
      "description": "Resumo/conte\u00fado da not\u00edcia"
    },
    "category": {
      "type": "string",
      "enum": [
        "anime",
        "manga",
        "movie",
        "liveaction",
        "general"
      ],
      "default": "general",
      "description": "Categoria da not\u00edcia"
    },
    "image_url": {
      "type": "string",
      "description": "Imagem opcional da not\u00edcia"
    },
    "source_url": {
      "type": "string",
      "description": "Link externo da fonte/original"
    },
    "source_name": {
      "type": "string",
      "description": "Nome da fonte (ex: Crunchyroll, ANN, MAL)"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de publica\u00e7\u00e3o"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Not\u00edcia em destaque (faixa abaixo do carrossel)"
    },
    "author_name": {
      "type": "string",
      "description": "Autor/editor da not\u00edcia"
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}