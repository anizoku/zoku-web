{
  "name": "WorkCategoryVisibility",
  "type": "object",
  "properties": {
    "work_slug": {
      "type": "string",
      "description": "Slug \u00fanico da obra no cat\u00e1logo"
    },
    "work_title": {
      "type": "string",
      "description": "T\u00edtulo da obra (para refer\u00eancia)"
    },
    "show_in_animes": {
      "type": "boolean",
      "default": true
    },
    "show_in_mangas": {
      "type": "boolean",
      "default": true
    },
    "show_in_liveaction": {
      "type": "boolean",
      "default": true
    },
    "show_in_filmes": {
      "type": "boolean",
      "default": true
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "work_slug"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}