{
  "name": "WorkSuggestion",
  "type": "object",
  "properties": {
    "suggested_by_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que sugeriu"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo da obra sugerida"
    },
    "type": {
      "type": "string",
      "enum": [
        "anime",
        "manga"
      ],
      "description": "Tipo da obra"
    },
    "mal_id": {
      "type": "number",
      "description": "ID no MyAnimeList"
    },
    "image_url": {
      "type": "string",
      "description": "URL da capa retornada pelo Jikan"
    },
    "synopsis": {
      "type": "string",
      "description": "Sinopse curta"
    },
    "year": {
      "type": "number"
    },
    "score": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "description": "Status da obra no MAL"
    },
    "episodes": {
      "type": "number"
    },
    "chapters": {
      "type": "number"
    },
    "genres": {
      "type": "string",
      "description": "G\u00eaneros separados por v\u00edrgula"
    },
    "mal_url": {
      "type": "string",
      "description": "Link para a p\u00e1gina no MAL"
    },
    "suggestion_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "admin_note": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o do admin ao aprovar ou rejeitar"
    },
    "created_at": {
      "type": "string",
      "description": "ISO timestamp da sugest\u00e3o"
    },
    "reviewed_at": {
      "type": "string",
      "description": "ISO timestamp da revis\u00e3o"
    }
  },
  "required": [
    "suggested_by_email",
    "title",
    "type",
    "mal_id"
  ],
  "rls": {
    "create": {
      "data.suggested_by_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.suggested_by_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}