{
  "name": "SiteConfig",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Identificador interno do registro de configura\u00e7\u00e3o (ex: 'default')"
    },
    "logo_compact_url": {
      "type": "string",
      "description": "URL da logo compacta (apenas \u00edcone/s\u00edmbolo)"
    },
    "logo_full_url": {
      "type": "string",
      "description": "URL da logo completa (\u00edcone + texto)"
    },
    "achievement_sound_url": {
      "type": "string",
      "description": "URL do som de conquista personalizado (vazio = usar som padr\u00e3o)"
    },
    "updated_by": {
      "type": "string",
      "description": "Email do admin que editou"
    }
  },
  "required": [
    "label"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}