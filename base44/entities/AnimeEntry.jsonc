{
  "name": "AnimeEntry",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da obra can\u00f4nica (franchise title ap\u00f3s merge de temporadas)"
    },
    "type": {
      "type": "string",
      "enum": [
        "anime",
        "manga"
      ],
      "default": "anime"
    },
    "cover_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "watching",
        "reading",
        "completed",
        "planned",
        "dropped",
        "on_hold"
      ],
      "default": "planned"
    },
    "current_episode": {
      "type": "number",
      "default": 0
    },
    "total_episodes": {
      "type": "number"
    },
    "current_chapter": {
      "type": "number",
      "default": 0
    },
    "total_chapters": {
      "type": "number"
    },
    "rating": {
      "type": "number",
      "description": "User rating 1-10"
    },
    "notes": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "season_mal_id": {
      "type": "number",
      "description": "mal_id da temporada espec\u00edfica \u00e0 qual o progresso se refere (ap\u00f3s merge de franchise). Null = raiz/\u00fanica temporada."
    }
  },
  "required": [
    "title",
    "type"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}