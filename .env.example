# Ativação controlada. true seleciona as rotas Supabase, sem importar o app Base44.
# Áreas ainda não migradas exibem indisponibilidade temporária nesse modo.
VITE_ENABLE_SUPABASE_AUTH=false
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_PUBLICA

# Não colocar secret/service-role em nenhuma variável VITE_*.
